{
    "name": "notakey/simplesamlphp-module-autoauth",
    "description": "A SimpleSAMLphp module for automatic auth source selection.",
    "type": "simplesamlphp-module",
    "keywords": ["adfs home realm discovery", "windows integrated authentication"],
    "license": "MIT",
    "authors": [{
        "name": "Ingemars Asmanis",
        "email": "ingemars.asmanis@notakey.com"
    }],
    "autoload": {
        "psr-4": {
            "SimpleSAML\\Module\\autoauth\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "simplesamlphp/composer-module-installer": "^1.7",
        "simplesamlphp/simplesamlphp": "^2.5",
        "symfony/http-foundation": "^7.4"
    },
    "config": {
        "allow-plugins": {
            "simplesamlphp/composer-module-installer": true
        }
    }
}
